# AMW online (PHP-Webhoster, Apache/LiteSpeed)
Options -Indexes
DirectoryIndex index.php

RewriteEngine On
# immer HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# versteckte Dateien (.git, .htaccess …) und alles außer den beiden Einstiegen und den Anleitungs-Bildern sperren
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_URI} !(^|/)(index\.php|api\.php|hilfe/[a-z0-9-]+\.webp|hilfe/[a-z0-9-]+\.(de|en)\.json)?$
RewriteRule ^ - [F,L]

<Files "amw-konfig.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # X-Frame-Options setzt die Seite selbst (inc/lib.php: DENY; Dokument-Dateien in api.php: SAMEORIGIN, damit ein Mockup
  # im eigenen Dokument-Fenster erscheint). Hier zusätzlich gesetzt, käme die Angabe doppelt an – Browser nehmen dann die strengere.
  Header always set Referrer-Policy "same-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
